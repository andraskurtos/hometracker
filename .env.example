# Deployment configuration for docker compose (docker-compose.yml).
# Copy to .env and fill in.  ->  cp .env.example .env

# --- Postgres ---
# Used by both the db container and the api container.
DB_NAME=pantry_db
DB_USER=andrish
DB_PASSWORD=change_me

# --- Auth ---
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_KEY=change_me

# --- AI receipt parsing (LiteLLM → Gemini) ---
LLM_MODEL=gemini/gemini-2.5-flash
GEMINI_API_KEY=change_me

# --- Web ---
# Port the UI is published on: http://<server-lan-ip>:<WEB_PORT>
WEB_PORT=80
