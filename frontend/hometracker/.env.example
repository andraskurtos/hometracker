# Optional frontend overrides. Copy to .env.local to use.
#
# Leave VITE_API_ORIGIN unset for the default: same-origin. In dev the Vite
# proxy forwards /api and /uploads to the backend; in production nginx does.
# Set it (e.g. http://192.168.0.10:8000) only to point the UI at a backend
# running on another host.
VITE_API_ORIGIN=
