# Template for api/.env — copy to .env and fill in.
#
# This file configures LOCAL development (running uvicorn directly on the host
# against the Postgres container from api/docker-compose.yml). The deployed
# Docker stack is configured by the ROOT .env instead — see ../.env.example.

# --- Database ---
DB_NAME=pantry_db
DB_USER=andrish
DB_PASSWORD=change_me
DB_HOST=127.0.0.1
DB_PORT=5432

# --- Auth ---
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_KEY=change_me

# --- AI receipt parsing (LiteLLM) ---
# Any LiteLLM-supported vision model, e.g. gemini/gemini-2.5-flash
LLM_MODEL=gemini/gemini-2.5-flash
GEMINI_API_KEY=change_me

# --- Uploads ---
UPLOAD_DIR=uploads/avatars

# --- Web Push (VAPID) ---
# Generate once (in the venv): python -c "from py_vapid import Vapid; v=Vapid(); v.generate_keys(); ..."
# Then paste the base64url private/public key pair below.
VAPID_PRIVATE_KEY=change_me
VAPID_PUBLIC_KEY=change_me
VAPID_SUBJECT=mailto:admin@your-app.com  # Must be a real TLD — Apple rejects .local
